const YEARS = DATA.years;
const SEQ = ['#BBD3E0','#5A93B8','#1F3D5C'];
const LINECOL = {district:'#1F3D5C', Elementary:'#4E9D6B', Middle:'#D98A3D', High:'#D26161'};
const fmt = v => v==null ? '—' : v+'%';

let trendChart, barChart, sortState={col:2,dir:'desc'};

function gsel(){return document.getElementById('fGroup').value;}
function lsel(){return document.getElementById('fLevel').value;}
function ysel(){return document.getElementById('fYear').value;} // 'all' or '0/1/2'
function schoolsFiltered(){const l=lsel();return DATA.schools.filter(s=>l==='All'||s.level===l);}
function levelMean(level,group,yi){
  const arr=DATA.schools.filter(s=>s.level===level).map(s=>s.rates[group][yi]).filter(v=>v!=null);
  return arr.length?Math.round(arr.reduce((a,b)=>a+b,0)/arr.length*10)/10:null;
}

function initFilters(){
  const sel=document.getElementById('fGroup');
  const mk=(label,arr)=>{const og=document.createElement('optgroup');og.label=label;arr.forEach(g=>{const o=document.createElement('option');o.value=g;o.textContent=g;og.appendChild(o);});sel.appendChild(og);};
  mk('Need groups',DATA.needGroups);
  mk('Race / ethnicity',DATA.raceGroups.filter(g=>g!=='All Students'));
  sel.value='All Students';
  ['fGroup','fLevel','fYear'].forEach(id=>document.getElementById(id).addEventListener('change',render));
}

function renderKPIs(){
  const g=gsel(), d=DATA.district[g], yi=ysel()==='all'?2:+ysel();
  const yLabel=YEARS[yi];
  const chg=Math.round((d[2]-d[0])*10)/10;
  const fl=schoolsFiltered();
  const benchmark=d[2];
  const above=fl.filter(s=>s.rates[g][2]!=null && s.rates[g][2]>benchmark).length;
  const ranked=fl.filter(s=>s.rates[g][2]!=null).sort((a,b)=>b.rates[g][2]-a.rates[g][2]);
  const hi=ranked[0], lo=ranked[ranked.length-1];
  const k=[
    {lab:`District — ${g}`, val:fmt(d[yi]), sub:`School year ${yLabel}`},
    {lab:'Change since 2022–23', val:(chg>0?'+':'')+chg+' pp', sub:chg<0?'improved (rate fell)':(chg>0?'worsened (rate rose)':'no change'), cls:chg<0?'down':(chg>0?'up':'')},
    {lab:`Schools above district ${YEARS[2]}`, val:above+' of '+fl.length, sub:`> ${fmt(benchmark)} (${g})`}
  ];
  document.getElementById('kpis').innerHTML=k.map(x=>`<div class="kpi"><div class="lab">${x.lab}</div><div class="val">${x.val}</div><div class="sub ${x.cls||''}">${x.sub}</div></div>`).join('');
}

function renderTrend(){
  const g=gsel();
  const useOfficial = (g==='All Students' && DATA.officialLevelTrend);
  document.getElementById('trendTitle').textContent=`District & level trend — ${g}`;
  document.getElementById('trendSub').textContent = useOfficial
    ? 'Official district total and Elementary / Middle / High level totals'
    : 'District total (official); level lines are the average across schools in each level';
  const ds=[
    {label:'District total',data:DATA.district[g],borderColor:LINECOL.district,backgroundColor:LINECOL.district,borderWidth:3,tension:.25,pointRadius:4,pointHoverRadius:6},
    ...['Elementary','Middle','High'].map(lv=>({label:lv+(useOfficial?'':' avg'),data:useOfficial?DATA.officialLevelTrend[lv]:YEARS.map((_,i)=>levelMean(lv,g,i)),borderColor:LINECOL[lv],backgroundColor:LINECOL[lv],borderWidth:2,borderDash:[5,4],tension:.25,pointRadius:3,pointHoverRadius:5}))
  ];
  if(trendChart){trendChart.data.datasets=ds;trendChart.update('none');return;}
  trendChart=new Chart(document.getElementById('trendChart'),{type:'line',
    data:{labels:YEARS,datasets:ds},
    options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},
      plugins:{legend:{position:'bottom',labels:{usePointStyle:true,padding:16,font:{size:11}}},
        tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.parsed.y)}`}}},
      scales:{y:{beginAtZero:true,suggestedMax:50,grid:{color:'#E4E8EC'},ticks:{callback:v=>v+'%'}},x:{grid:{display:false}}}}});
}

function renderBar(){
  const g=gsel(), y=ysel(), fl=schoolsFiltered();
  document.getElementById('barTitle').textContent=`Chronic absenteeism by school — ${g}`;
  let datasets, sorted;
  if(y==='all'){
    sorted=[...fl].sort((a,b)=>(b.rates[g][2]??-1)-(a.rates[g][2]??-1));
    document.getElementById('barSub').textContent='All three years (sorted by 2024–25)';
    datasets=[0,1,2].map(i=>({label:YEARS[i],data:sorted.map(s=>s.rates[g][i]),backgroundColor:SEQ[i],borderRadius:2}));
  }else{
    const yi=+y;
    sorted=[...fl].sort((a,b)=>(b.rates[g][yi]??-1)-(a.rates[g][yi]??-1));
    document.getElementById('barSub').textContent=`School year ${YEARS[yi]} (sorted)`;
    datasets=[{label:YEARS[yi],data:sorted.map(s=>s.rates[g][yi]),backgroundColor:SEQ[yi],borderRadius:2}];
  }
  const labels=sorted.map(s=>s.name);
  const cfg={labels,datasets};
  if(barChart){barChart.data=cfg;barChart.update('none');return;}
  barChart=new Chart(document.getElementById('barChart'),{type:'bar',data:cfg,
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{usePointStyle:true,font:{size:11}}},
        tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.parsed.y)}`}}},
      scales:{y:{beginAtZero:true,suggestedMax:60,grid:{color:'#E4E8EC'},ticks:{callback:v=>v+'%'}},
        x:{grid:{display:false},ticks:{font:{size:9},maxRotation:90,minRotation:90}}}}});
}

function bucket(diff){if(diff>=10)return'#D9786B';if(diff>=5)return'#ECA99E';if(diff>-5)return'#F1EEE9';if(diff>-10)return'#BBD3E0';return'#7FB1D6';}
function renderHeat(){
  const yi=ysel()==='all'?2:+ysel();
  document.getElementById('heatSub').textContent=`Cell color = ${YEARS[yi]} rate vs district average for that group; arrow = change from 2022–23 to ${YEARS[yi]}`;
  document.getElementById('heatLegend').innerHTML=
    [['#D9786B','≥10pp above'],['#ECA99E','5–10 above'],['#F1EEE9','±5 (≈avg)'],['#BBD3E0','5–10 below'],['#7FB1D6','≥10 below']]
      .map(([c,t])=>`<span><span class="sw" style="background:${c}"></span>${t}</span>`).join('')
    +' &nbsp; | &nbsp; <span class="arrow dn">▼</span> improved &nbsp; <span class="arrow up">▲</span> worsened';
  const groups=DATA.groups, fl=schoolsFiltered();
  let h='<thead><tr><th class="sch">School</th>';
  groups.forEach(g=>{h+=`<th>${g.replace('Students with Disabilities','Students w/ Disab.')}<span class="da">avg ${fmt(DATA.district[g][yi])}</span></th>`;});
  h+='</tr></thead><tbody>';
  fl.forEach(s=>{
    h+=`<tr><td class="sch">${s.name}</td>`;
    groups.forEach(g=>{
      const v=s.rates[g][yi], v0=s.rates[g][0];
      if(v==null){h+='<td style="background:#EDEDED">—</td>';return;}
      const diff=v-DATA.district[g][yi];
      let ar='–',cl='fl';
      if(v0!=null&&v<v0){ar='▼';cl='dn';}else if(v0!=null&&v>v0){ar='▲';cl='up';}
      h+=`<td style="background:${bucket(diff)}" title="${s.name} — ${g}\n${YEARS[0]}: ${fmt(v0)} → ${YEARS[yi]}: ${fmt(v)}\nDistrict ${g} ${YEARS[yi]}: ${fmt(DATA.district[g][yi])}">${Math.round(v)}% <span class="arrow ${cl}">${ar}</span></td>`;
    });
    h+='</tr>';
  });
  document.getElementById('heatTable').innerHTML=h+'</tbody>';
}

function renderTable(){
  const g=gsel(), fl=schoolsFiltered();
  document.getElementById('tblTitle').textContent=`School detail — ${g}`;
  const cols=[{f:'name',l:'School'},{f:'level',l:'Level'},{f:0,l:YEARS[0]},{f:1,l:YEARS[1]},{f:2,l:YEARS[2]},{f:'chg',l:'Change (pp)'}];
  const rows=fl.map(s=>({name:s.name,level:s.level,0:s.rates[g][0],1:s.rates[g][1],2:s.rates[g][2],
    chg:(s.rates[g][0]!=null&&s.rates[g][2]!=null)?Math.round((s.rates[g][2]-s.rates[g][0])*10)/10:null}));
  rows.sort((a,b)=>{const c=sortState.col,av=a[c],bv=b[c];
    if(av==null)return 1;if(bv==null)return -1;
    const cmp=(av<bv?-1:av>bv?1:0);return sortState.dir==='asc'?cmp:-cmp;});
  let h='<thead><tr>';
  cols.forEach(c=>{const ar=sortState.col===c.f?(sortState.dir==='asc'?' ▲':' ▼'):'';h+=`<th data-c="${c.f}">${c.l}${ar}</th>`;});
  h+='</tr></thead><tbody>';
  rows.forEach(r=>{
    const chgTxt=r.chg==null?'—':`<span class="pill" style="background:${r.chg<0?'#DCEFE3':r.chg>0?'#F7DAD7':'#EEE'};color:${r.chg<0?'#2E7D52':r.chg>0?'#C0392B':'#666'}">${r.chg>0?'+':''}${r.chg}</span>`;
    h+=`<tr><td>${r.name}</td><td>${r.level}</td><td>${fmt(r[0])}</td><td>${fmt(r[1])}</td><td>${fmt(r[2])}</td><td>${chgTxt}</td></tr>`;
  });
  document.getElementById('dataTable').innerHTML=h+'</tbody>';
  document.querySelectorAll('#dataTable th').forEach(th=>th.addEventListener('click',()=>{
    let c=th.dataset.c; if(c!=='name'&&c!=='level')c=+c;
    if(sortState.col===c)sortState.dir=sortState.dir==='asc'?'desc':'asc';else{sortState.col=c;sortState.dir='desc';}
    renderTable();
  }));
}

function render(){renderKPIs();renderTrend();renderBar();renderHeat();renderTable();}
initFilters();render();
</script>
